{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Nest Application",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run-script",
        "start:debug"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "restart": true,
      "console": "integratedTerminal"
    },
    {
      "type": "node-terminal",
      "name": "Run Script: db:seed",
      "request": "launch",
      "command": "npm run db:seed",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "name": "Run Script: test:turn-context-persistence",
      "request": "launch",
      "command": "npm run test:turn-context-persistence",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "name": "Run Script: test:same-turn-substitution-guard",
      "request": "launch",
      "command": "npm run test:same-turn-substitution-guard",
      "cwd": "${workspaceFolder}"
    }
  ]
}