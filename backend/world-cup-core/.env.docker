# --- Swagger ---
SWAGGER_APP_TITLE=World Cup Core Service
SWAGGER_APP_DESCRIPTION=World Cup Core API
SWAGGER_APP_VERSION=1.0.0
SWAGGER_BASE_PATH=
SWAGGER_THEME=dark

# --- App Config ---
APP_PORT=4101
APP_BASE_PATH=worldCupCore
APP_LOG_LEVEL=log

# --- Comunicación Interna Docker ---
# Le pega al servicio 'world-cup-api' dentro de la red de contenedores
WORLD_CUP_API_URL=http://world-cup-api:5101
WORLD_CUP_API_BASE_PATH=/worldCup

# --- CORS ---
CORS_ALLOWED_ORIGIN=http://localhost:3101

# --- Negocio ---
TEAM_ID=tun
APP_LANG=es

# --- Configuración de Automatización n8n ---
AI_N8N_WEBHOOK_URL=http://localhost:5678/webhook/WorldCup